# ============================================================
# Nexora Environment Configuration Template
# Copy this file to '.env' and fill in your provider API keys.
# DO NOT commit '.env' with real secrets to version control.
# ============================================================

# Providers
NVIDIA_NIM_API_KEY=nvapi-your_nvidia_nim_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
CODESTRAL_API_KEY=your_codestral_api_key_here
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
KIMI_API_KEY=sk-your_kimi_api_key_here
OPENCODE_API_KEY=sk-your_opencode_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=gsk_your_groq_api_key_here
